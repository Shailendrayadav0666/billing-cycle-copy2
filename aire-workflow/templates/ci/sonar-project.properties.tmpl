# SonarQube configuration — generated by AIRE. Only ${SLOT} values vary (Section 4.1.1).
# 🔴 sonar.organization is left as YOUR_ORG_NAME for the user to set; AIRE cannot know the org key.
#    Self-hosted SonarQube does not use organizations — delete that line instead.
# 🔴 No token belongs in this file. SONAR_TOKEN / SONAR_HOST_URL are GitHub Actions secrets only.

sonar.projectKey=${SONAR_PROJECT_KEY}
sonar.projectName=${SONAR_PROJECT_NAME}
sonar.organization=YOUR_ORG_NAME

sonar.sources=${SONAR_SOURCES}
sonar.tests=${SONAR_TESTS}
sonar.exclusions=${SONAR_EXCLUSIONS}

# Coverage report path for the detected test runner (one of the lines below is emitted by the generator):
${SONAR_COVERAGE_REPORT_PATH}

sonar.sourceEncoding=UTF-8
